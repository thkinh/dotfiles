{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/Pictures/_Collections/Zutomayo/BlackNeko.png",
        "width": 25,
        "height": 12,
        //"source": "arch3",
        "color": {
            "1": "red",
            "2": "red"
        },
        "padding": {
            "top": 1,
            "right": 5
        }
    },    
    "modules": 
    [
        {
            "type": "custom",
            "format": "\u001b[90m┌──────────────────────Hardware──────────────────────┐"
        },
        {
            "type": "host",
            "key": "󰌢  PC",
            "keyColor": "green"
        },
        {
            "type": "memory",
            "key": "│ 󰑭 ",
            "keyColor": "green"
        },
        {
            "type": "disk",
            "key": "│ 󰋊 ",
            "keyColor": "green"
        },
        {
            "type": "custom",
            "format": "\u001b[90m└────────────────────────────────────────────────────┘"
        },
        {
            "type": "colors",
            "symbol": "circle"
        },
        {
            "type": "custom",
            "format": "\u001b[90m┌──────────────────────Software──────────────────────┐"
        },
        {
            "type": "os",
            "key": "  OS",
            "keyColor": "yellow"
        },
        {
            "type": "kernel",
            "key": "│ 󰌽 ",
            "keyColor": "yellow"
        },
        {
            "type": "bios",
            "key": "│ 󰖡 ",
            "keyColor": "yellow"
        },
        {
            "type": "packages",
            "key": "│ 󰏗 ",
            "keyColor": "yellow"
        },
        {
            "type": "shell",
            "key": "├ 󰞷 ",
            "keyColor": "yellow"
        },
        {
            "type": "wm",
            "key": "│ 󱂬 ",
            "keyColor": "blue"
        },
        {
            "type": "terminal",
            "key": "├ 󰆍 ",
            "keyColor": "blue"
        },
        {
            "type": "custom",
            "format": "\u001b[1;34m│",
            "keyColor": "blue"
        },
        {
            "type": "command",
            "key": "│   OS Age  ",
            "keyColor": "magenta",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "uptime",
            "key": "│ 󱎫  Uptime  ",
            "keyColor": "magenta"
        },
        {
            "type": "command",
            "key": "│ 󰪵  Running ",
            "text": "t=$(unset LIBPROC_HIDE_KERNEL; ps -e | wc -l); u=$(LIBPROC_HIDE_KERNEL=1 ps -e | wc -l); echo \"$u/$t\"",
            "format": "{} processes (user/total)",
            "keyColor": "magenta"
        },
        {
            "type": "custom",
            "format": "\u001b[90m└────────────────────────────────────────────────────┘"
        },
    ]
}
