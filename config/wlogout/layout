{
    "label" : "lock",
    "action" : "~/.config/hypr/scripts/lock.sh",
    "text" : "Lock",
    "keybind" : "l"
}

{
    "label" : "logout",
    "action" : "loginctl terminate-user $USER",
    "text" : "Logout",
    "keybind" : "e"
}

{
    "label" : "shutdown",
    "action" : "shutdown -h now",
    "text" : "Shutdown",
    "keybind" : "s"
}

{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : "Reboot",
    "keybind" : "r"
}

{
    "label" : "suspend",
    "action" : "systemctl suspend",
    "text" : "Sleep",
    "keybind" : "u"
}

{
    "label" : "hyprland",
    "action" : "hyprctl reload",
    "text" : "HyprReload",
    "keybind" : "r"
}
